# ─────────────────────────────────────────────────────────────
# BuildGhana Abroad — environment variables
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# Every integration is OFF until its variables are set. Nothing is "connected" by default.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_BRAND_NAME=BuildGhana Abroad
# Optional WhatsApp business number, digits only with country code (e.g. 16175550100). Leave blank to hide.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Consent default for analytics/ads storage before the visitor chooses: "denied" (recommended) or "granted"
NEXT_PUBLIC_CONSENT_DEFAULT=denied

# Google Tag Manager (GA4, Google Ads and Meta Pixel tags live inside GTM)
NEXT_PUBLIC_GTM_ID=

# GoHighLevel (LeadConnector API v2) — use a Private Integration token scoped to contacts, opportunities, notes
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Pipeline + stage IDs (Settings → Pipelines; copy the IDs from the API or URL)
GHL_PIPELINE_ID=
GHL_STAGE_NEW_LEAD=
GHL_STAGE_PRIORITY=
# Optional: JSON map of website-lead stages, e.g. {"new_lead":"id","priority":"id","standard":"id","nurture":"id"}. Overrides the two vars above.
GHL_STAGE_IDS=
# JSON map of website field → GHL custom field ID. See docs/07-ghl-data-mapping.md
# e.g. {"current_country":"abc123","ghana_region":"def456",...}
GHL_CUSTOM_FIELD_IDS=
# Public booking widget URL from GHL Calendars (used as iframe on /book-consultation)
NEXT_PUBLIC_GHL_BOOKING_URL=
# Shared secret that GHL workflows send in the X-Webhook-Secret header to /api/crm-webhook
CRM_WEBHOOK_SECRET=

# Meta Conversions API (server-side). Pixel itself is configured in GTM.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Set only while testing in Events Manager → Test Events. Remove in production.
META_TEST_EVENT_CODE=

# GA4 Measurement Protocol (server-side offline events: qualified_lead, purchase)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Storage, idempotency and rate limiting (Upstash Redis REST). Without these the app
# falls back to in-memory (dev only — NOT durable on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile spam protection (optional, recommended once ads are live)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead scoring override: paste full JSON (same shape as src/config/lead-scoring.json) to change rules without a code deploy
LEAD_SCORING_JSON=

# Internal notification email is handled by GHL workflows; no SMTP needed here.

# LOCAL TESTING ONLY: allow `next start` to accept leads into process memory without Upstash/GHL. Never set in Vercel.
LEAD_ALLOW_MEMORY_STORE=

# --- OpenAI Ads (ChatGPT ads) — Ads Manager → Conversions tab ---
# Browser pixel (public). Loads only after advertising consent; GPC always blocks it.
NEXT_PUBLIC_OPENAI_PIXEL_ID=
# Set "true" while testing to log pixel activity in the browser console.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
# Conversions API (server only, never expose). Must use the SAME pixel id as above for dedup.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_API_KEY=
# "true" = OpenAI validates events but does not record them. Turn off at launch.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_INTEGRATION_SOURCE=

# --- Team lead brief email (Resend): budget fit, size, requested consultation time, add-to-calendar ---
RESEND_API_KEY=
LEAD_BRIEF_FROM=
LEAD_BRIEF_TO=

# --- Content-Security-Policy ---
# CSP ships as Report-Only (allows OpenAI pixel bzrcdn/bzr.openai.com, GTM/GA4, Meta, Turnstile, GHL, Supabase).
# Check the browser console for violations after GTM is live, then set "true" to enforce.
CSP_ENFORCE=

# =====================================================================================
# PHASE 2 — Ghana Build Readiness Review (docs/19-readiness-review.md)
# Everything below is optional. With nothing set the review runs in SANDBOX mode on
# non-production deployments (mock checkout, local /tmp storage, admin locked).
# =====================================================================================

# --- Fees (owner-set). Admin "Fees & settings" (/admin/readiness) override these. Blank = "Price set by owner".
# BASE_REVIEW_FEE in whole currency units, e.g. BASE_REVIEW_FEE_USD=450. Real checkout refuses to start until a fee exists.
# (READINESS_PRICE_USD / READINESS_PRICE_GHS are still accepted as aliases.) Add-on prices are set in admin only and are
# never charged at checkout — they are quoted per case and charged only after the client approves.
BASE_REVIEW_FEE_USD=
BASE_REVIEW_FEE_GHS=
READINESS_TURNAROUND_DAYS=
# Exchange rate shown wherever two currencies appear (and used for USD equivalents of GHS cost ranges).
READINESS_FX_USD_GHS=
READINESS_FX_SOURCE=
READINESS_FX_DATE=
# Client-facing text: service area and refund/cancellation terms. Blank = "set by owner" notice.
READINESS_COVERAGE=
READINESS_REFUND_POLICY=
# Link-only client emails (report ready / documents needed) via Resend (RESEND_API_KEY above). Blank = logged no-op.
READINESS_EMAIL_FROM=
READINESS_EMAIL_REPLY_TO=

# --- Secrets (generate with: openssl rand -hex 32). Required in production.
# Signs the private case-page links sent to clients.
READINESS_TOKEN_SECRET=
# Signs short-lived document upload/download URLs (local adapter).
DOCS_SIGNING_SECRET=
# Admin queue at /admin/readiness. 16+ random characters. Unset = admin locked (404).
ADMIN_TOKEN=

# --- Payments: Stripe (USD, card) ---
# Dashboard → Developers → API keys / Webhooks. Webhook URL: https://<domain>/api/readiness/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Payments: Paystack (GHS, card + mobile money) ---
# Settings → API Keys & Webhooks. Webhook URL: https://<domain>/api/readiness/webhooks/paystack (signature = HMAC-SHA512 with the secret key)
PAYSTACK_SECRET_KEY=
# Sandbox controls. Mock checkout is available on non-production deployments only.
# PAYMENTS_FORCE_MOCK=1 uses the mock even if keys exist (staging demos). Never set READINESS_ALLOW_MOCK_PAYMENTS in production.
PAYMENTS_FORCE_MOCK=
READINESS_ALLOW_MOCK_PAYMENTS=
READINESS_MOCK_WEBHOOK_SECRET=

# --- Document storage: S3 or Cloudflare R2 (private bucket). Unset = local adapter (sandbox, /tmp, 4 MB cap, not durable on Vercel).
# R2: DOCS_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com DOCS_S3_REGION=auto. Add a CORS rule allowing PUT from your domain.
DOCS_S3_BUCKET=
DOCS_S3_ENDPOINT=
DOCS_S3_REGION=
DOCS_S3_ACCESS_KEY_ID=
DOCS_S3_SECRET_ACCESS_KEY=
# Local adapter directory (defaults to the OS temp dir).
DOCS_LOCAL_DIR=

# --- GoHighLevel: Readiness Review pipeline (separate from website leads so revenue stays separable) ---
# JSON keyed by logical stage: {"new_inquiry":"id","intake_started":"id","payment_pending":"id","paid_review":"id","documents_incomplete":"id",
#   "site_visit_scheduled":"id","legal_title_check":"id","report_delivered":"id","pm_proposal":"id","won":"id","lost":"id"}
# Contact custom fields (optional, via GHL_FIELD_IDS): rr_case_id, rr_case_number, rr_status, rr_title_status, rr_project_type, rr_location,
#   rr_budget_band, rr_lead_score, rr_case_url (admin link, no client token), rr_amount, rr_currency.
# Without GHL credentials every sync is a logged no-op ([ghl:noop]). Documents are never sent to GHL.
GHL_RR_PIPELINE_ID=
GHL_RR_STAGE_IDS=

# --- Browser tags (all consent-gated). If NEXT_PUBLIC_GTM_ID is set, configure these inside GTM instead.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels from Google Ads → Goals → Conversions (the part after the slash in AW-XXXX/label).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel (browser) — dedups with Meta CAPI (META_PIXEL_ID / META_CAPI_TOKEN above) via shared event ids.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Ads offline conversion upload (server). Inactive (logs only) unless ALL required values are set.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Resource name, e.g. customers/1234567890/conversionActions/987654321
GOOGLE_ADS_CONVERSION_ACTION_PURCHASE=

# --- Intent data (DataMoon / AudienceLab). DISABLED BY DEFAULT (docs/16-intent-data-layer.md).
# Requires INTENT_ENABLED=true AND a vendor + key. Advertising consent required; GPC always blocks; only hashed emails leave the server.
INTENT_ENABLED=
INTENT_VENDOR=
INTENT_API_KEY=
INTENT_API_BASE=
INTENT_WEBHOOK_SECRET=
NEXT_PUBLIC_INTENT_ENABLED=
NEXT_PUBLIC_INTENT_PIXEL_SRC=

# --- Staging. STAGING=1 (or any non-production VERCEL_ENV) adds noindex headers/meta and blocks robots. Never set on production.
STAGING=

# ───────────── Phase 3: SEO / canonical ─────────────
# Final canonical origin (owner approval). Falls back to NEXT_PUBLIC_SITE_URL. Never a vercel.app staging host.
NEXT_PUBLIC_CANONICAL_URL=
# Production indexing switch. Staging (VERCEL_ENV != production or STAGING=1) is ALWAYS noindex regardless.
# Leave unset/true to keep current production indexing; set "false" to hold production out of search until launch.
NEXT_PUBLIC_INDEXABLE_SITE=
NEXT_PUBLIC_CONTACT_EMAIL=

# ───────────── Phase 3: Property introductions (private, admin-assisted) ─────────────
# REQUIRED in production: Upstash (KV_REST_API_URL / KV_REST_API_TOKEN above). Without it the seller/buyer
# forms return 503 in production — private property data is never kept in process memory (LEAD_ALLOW_MEMORY_STORE is ignored).
# Optional staff roles (16+ chars). ADMIN_TOKEN is the admin role.
PROPERTY_REVIEWER_TOKEN=
PROPERTY_LEGAL_TOKEN=
# "waitlist" (default: no public inventory) or "listings" (only seller-authorised, factually reviewed listings).
NEXT_PUBLIC_PROPERTY_OPPORTUNITIES_MODE=waitlist
# File retention (days) for property photos/videos/documents after a record closes. Default 365.
PROPERTY_RETENTION_DAYS=
# Optional malware scan hook: receives the file bytes (POST application/octet-stream, Bearer PROPERTY_SCAN_TOKEN) and returns {"clean":true/false}. Files stay "not_scanned" without it.
PROPERTY_SCAN_URL=
PROPERTY_SCAN_TOKEN=
# GHL pipelines (log mode until GHL_PRIVATE_TOKEN + GHL_LOCATION_ID are set). Stage maps are JSON keyed by status:
# submitted, contact_verified, documentation_requested, counsel_review_pending, reviewed, approved_for_introduction,
# matched, introduction_authorized, closed, lost, withdrawn. Custom fields (via GHL_FIELD_IDS): pp_record_id, pp_reference,
# pp_kind, pp_status, pp_legal_state, pp_residence_country, pp_preferred_contact, pp_admin_url, pp_region, pp_district,
# pp_property_type, pp_budget_band, pp_buyer_eligibility. Never GPS, directions, documents or prices for sellers.
GHL_PROP_SELLER_PIPELINE_ID=
GHL_PROP_SELLER_STAGE_IDS=
GHL_PROP_BUYER_PIPELINE_ID=
GHL_PROP_BUYER_STAGE_IDS=
# Optional internal webhook (e.g. a GHL inbound workflow) pinged with {matchId, refs, score, region} for staff review.
GHL_PROP_MATCH_WEBHOOK_URL=

# ───────────────────────── Phase 4: ops admin, CRM outbox, DataMoon ─────────────────────────
# Ops admin (/admin/ops). Locked (404) unless at least one staff identity exists. Legacy tokens still work:
# ADMIN_TOKEN → owner, PROPERTY_REVIEWER_TOKEN → operator, PROPERTY_LEGAL_TOKEN → legal_reviewer.
# Named staff (SECRET, server-only): JSON array of {"id","name","role","brands":["buildghana"],"tokenSha256"}.
# role ∈ owner|manager|marketer|estimator|operator|legal_reviewer|read_only. Store only sha256(token), never the token.
OPS_STAFF_JSON=
# Outbox worker: Vercel Cron / external scheduler calls GET /api/cron/outbox with "Authorization: Bearer $CRON_SECRET".
# Route is 404 while unset. (SECRET)
CRON_SECRET=

# DataMoon — US-based prospect audiences ONLY. No Ghana coverage, no ethnicity/diaspora targeting.
# Every flag defaults OFF; with no keys the vendor shows "disabled"/"not connected". Never set keys on Preview.
DATAMOON_ENABLED=false
DATAMOON_MAIN_API_ENABLED=false
DATAMOON_INTENT_ENABLED=false
# Live audience runs/exports for this brand (still require owner export approval per recipe):
DATAMOON_AUDIENCE_ACTIVATION_BUILDGHANA=false
# Vendor contact → GHL sync (also requires owner CRM-sync approval on the recipe). Never triggers outreach.
DATAMOON_GHL_SYNC_ENABLED=false
# Main API tier for audiences (owner decision, depends on the plan purchased): ext (/v2/ext/…, default) or module (/v2/m/…)
DATAMOON_MAIN_TIER=ext
DATAMOON_MAIN_BASE_URL=https://app.datamoon.com/api
DATAMOON_INTENT_BASE_URL=https://intentapi.datamoon.com
# SECRETS (server-only; main and intent credentials are separate):
DATAMOON_MAIN_MODULE_KEY=
DATAMOON_LEGACY_KEY=
DATAMOON_INTENT_KEY=
# whsec_… signing secret returned once by POST /webhooks (mode=create). Webhook route is 404 while unset.
DATAMOON_INTENT_WEBHOOK_SECRET=
# Guards (owner decision; 0/unset = every billable run is refused): max records per run, monthly record budget, vendor-contact retention.
DATAMOON_RECORD_CEILING=
DATAMOON_MONTHLY_RECORD_BUDGET=
DATAMOON_RETENTION_DAYS=90
# JSON {"<feed_id>":"buildghana"} — webhook events for unmapped feeds are ignored (cross-brand protection).
DATAMOON_FEED_BRAND_MAP=
# Synthetic fixtures are available outside production only; never enable this in production.
DATAMOON_ALLOW_FIXTURES_IN_PRODUCTION=false
